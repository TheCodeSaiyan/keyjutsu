{
  "name": "keyjutsu-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:index": "node packages/types/scripts/write-index.mjs",
    "schemas:check": "node schemas/check.mjs",
    "release:gates": "node scripts/release-gates.mjs",
    "desktop:dev": "pnpm --filter @keyjutsu/desktop tauri dev",
    "desktop:build": "pnpm --filter @keyjutsu/desktop tauri build",
    "tokens": "node scripts/design-tokens.mjs",
    "tokens:check": "node scripts/design-tokens.mjs --check"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "prettier": "^3.9.9"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keyjutsu:schema:plan:1.0",
  "title": "KeyJutsu plan, version 1.0",
  "description": "A structured implementation plan. Everything outside the `keyjutsu` property may be proposed by an agent; everything inside it is written only by KeyJutsu. See docs/schemas/plan.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "task_id", "target", "agent", "steps"],
  "properties": {
    "schema_version": {
      "description": "Major.minor. A reader refuses any major version it does not know rather than guessing.",
      "const": "1.0"
    },
    "plan_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "environment_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "requirements": {
      "description": "Tools the plan as a whole needs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_requirement"
      }
    },
    "phases": {
      "description": "Present when the plan crosses a session boundary such as a restart. Each phase lists its steps; the boundary after a phase is where the plan checkpoints.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "edges": {
      "description": "Control flow between steps. Without edges, steps run in order. An edge with `when` is followed only if its condition holds, which is how a plan branches.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "execution_preferences": {
      "$ref": "#/$defs/execution_preferences"
    },
    "questions": {
      "description": "What the agent needs the operator to decide rather than guess. Each is shown to the operator with its options; an answer goes back to the agent as guidance, and what it sends back is validated and approved like any change. An unanswered question does not block approval.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "keyjutsu": {
      "$ref": "#/$defs/keyjutsu_state"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version_constraint": {
      "description": "A semantic-version range such as \">=7.4 <8\" or an exact version.",
      "type": "string",
      "pattern": "^[0-9A-Za-z.*<>=~^| -]{1,64}$"
    },
    "target": {
      "description": "V1 has one target: this Windows machine. The model is target-aware so later targets need no reshaping.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["local_windows"]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "enum": ["codex", "claude_code", "gemini", "github_copilot", "cursor"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "check"],
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "check": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "tool_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "executable"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "version": {
          "$ref": "#/$defs/version_constraint"
        }
      }
    },
    "shell": {
      "description": "A command is never shell-agnostic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["pwsh", "windows_powershell", "cmd"]
        },
        "version": {
          "$ref": "#/$defs/version_constraint"
        },
        "architecture": {
          "enum": ["x64", "arm64", "x86"]
        },
        "encoding": {
          "enum": ["utf-8", "utf-16le", "oem"]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "description": "Exactly what is typed. A single line: control characters would submit or edit the line part-way through.",
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "objective", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "description": "`command` runs commands; `manual` is something the operator does outside the terminal; `user_input` hands the keyboard to the operator; `credential` is real, secure input that never passes through staged typing; `validation` only checks.",
          "enum": ["command", "manual", "user_input", "credential", "validation"]
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "shell": {
          "$ref": "#/$defs/shell"
        },
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "tool_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_requirement"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "privilege": {
          "enum": ["standard", "administrator"]
        },
        "proposed_risk": {
          "description": "The agent's view. KeyJutsu assesses risk itself and never relies on this alone.",
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "rationale"],
          "properties": {
            "level": {
              "$ref": "#/$defs/risk_level"
            },
            "rationale": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "reversibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": {
            "level": {
              "enum": ["full", "partial", "none"]
            },
            "notes": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "visible_validation": {
          "description": "Commands that show success on screen, run after the step.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "internal_validation": {
          "description": "Checks KeyJutsu makes without printing anything.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "network": {
          "$ref": "#/$defs/network_contract"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "execution_mode": {
          "$ref": "#/$defs/execution_mode"
        },
        "credential": {
          "$ref": "#/$defs/credential_request"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["credential"]
          },
          "then": {
            "description": "Only a credential step asks for a credential.",
            "properties": {
              "kind": {
                "const": "credential"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["command", "validation"]
              }
            }
          },
          "then": {
            "required": ["shell", "commands"],
            "properties": {
              "commands": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "credential"
              }
            }
          },
          "then": {
            "description": "A credential step cannot be staged: no commands are typed on the operator's behalf, and its mode is always user input. It says what it asks for; KeyJutsu asks for it through the shell's own masked prompt.",
            "required": ["credential"],
            "properties": {
              "commands": {
                "type": "array",
                "maxItems": 0
              },
              "execution_mode": {
                "const": "user_input"
              }
            }
          }
        }
      ]
    },
    "credential_request": {
      "description": "What a credential step asks the operator for. The plan names the variable the later steps use; the secret itself never appears in a plan.",
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "prompt", "kind"],
      "properties": {
        "variable": {
          "description": "The PowerShell variable the credential is held in for the rest of the run, as a SecureString or a PSCredential. Removed when the plan ends.",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "prompt": {
          "description": "What the operator is asked, shown by the shell's own prompt.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "kind": {
          "description": "`secret` is one masked value (a token, a password); `username_and_password` asks for both.",
          "enum": ["secret", "username_and_password"]
        },
        "username": {
          "description": "For `username_and_password`: the user name to suggest.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "risk_level": {
      "enum": ["low", "normal", "high", "critical"]
    },
    "execution_mode": {
      "enum": ["performance", "assisted", "auto_performance", "direct", "user_input"]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "enum": [
            "file_created",
            "file_modified",
            "file_deleted",
            "registry_value_set",
            "registry_value_deleted",
            "service_state",
            "service_start_type",
            "package_installed",
            "package_removed",
            "process_started",
            "git_commit",
            "git_push",
            "restart_required",
            "other"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "detail": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "condition": {
      "description": "A closed vocabulary. Exactly one key per object. There is deliberately no expression or script form: KeyJutsu evaluates conditions, and it only evaluates these.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "step_outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "is"],
          "properties": {
            "step": {
              "$ref": "#/$defs/id"
            },
            "is": {
              "enum": ["succeeded", "failed", "skipped"]
            }
          }
        },
        "exit_code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "equals"],
          "properties": {
            "step": {
              "$ref": "#/$defs/id"
            },
            "equals": {
              "type": "integer"
            }
          }
        },
        "fact": {
          "description": "A fact KeyJutsu collected from the machine, such as docker.backend. Agents name facts; they do not supply their values.",
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "equals"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
              "maxLength": 128
            },
            "equals": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "tool_version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "satisfies"],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "satisfies": {
              "$ref": "#/$defs/version_constraint"
            }
          }
        },
        "path_exists": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "service_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "state"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "state": {
              "enum": ["running", "stopped", "paused", "missing"]
            }
          }
        }
      }
    },
    "check": {
      "description": "An internal validation. Same closed-vocabulary rule as conditions.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["equals"],
          "properties": {
            "equals": {
              "type": "integer"
            }
          }
        },
        "service_state": {
          "$ref": "#/$defs/condition/properties/service_state"
        },
        "path_exists": {
          "$ref": "#/$defs/condition/properties/path_exists"
        },
        "file_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "json_value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "pointer", "equals"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "pointer": {
              "type": "string",
              "pattern": "^(/[^/]*)*$",
              "maxLength": 512
            },
            "equals": {}
          }
        },
        "tcp_port_open": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "http_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "status"],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "maxLength": 2048
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          }
        },
        "timeout_seconds": {
          "description": "Wrap-around for waiting checks: how long runtime validation may wait for the others to hold.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "description": "Recovery is execution: whatever it runs is validated and approved like any other step.",
          "enum": ["restore_captured_state", "commands", "none"]
        },
        "capture": {
          "description": "State to capture before the step runs, so it can be restored.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target"],
            "properties": {
              "kind": {
                "enum": ["file", "registry_value", "service_state", "package_version"]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "network_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destinations"],
      "properties": {
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "protocol", "purpose", "at_runtime"],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "protocol": {
                "enum": ["https", "http", "ssh", "smb", "git", "winrm", "other"]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "purpose": {
                "$ref": "#/$defs/text"
              },
              "at_runtime": {
                "description": "False when the dependency can be staged before arming, which is preferred.",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "description": "Where it is downloaded from when staged: HTTPS, or plain HTTP only from this machine (a local mirror). The pinned sha256, not the transport, is what makes the copy trustworthy.",
          "type": "string",
          "pattern": "^(https://|http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]{1,5})?/)",
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "publisher": {
          "type": "string",
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "boundary_after": {
          "enum": ["windows_restart", "sign_out", "shell_restart", "wsl_restart", "docker_restart"]
        }
      }
    },
    "execution_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_mode": {
          "$ref": "#/$defs/execution_mode"
        },
        "submit": {
          "enum": ["any_key", "require_enter", "auto_submit"]
        },
        "show_validation": {
          "enum": ["meaningful", "all", "none"]
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "step": {
          "description": "The step the question is about; absent for the whole plan.",
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "options": {
          "description": "Answers the operator can pick. Without any, the operator answers in their own words.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "free_text": {
          "description": "Whether the operator may answer in their own words as well as pick an option.",
          "type": "boolean"
        },
        "assumed": {
          "description": "Which option (counting from 0) the plan already follows. Choosing it keeps the plan as it is, without asking the agent again.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "keyjutsu_state": {
      "description": "Written only by KeyJutsu: validation results, assessed risk, hashes and approvals. An agent proposal containing this property is rejected (see proposal.schema.json).",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["readiness", "proof_level"],
            "properties": {
              "readiness": {
                "enum": ["READY", "BLOCKED", "INVALID", "NEEDS_REVIEW", "REVALIDATION_REQUIRED"]
              },
              "proof_level": {
                "enum": ["NONE", "LOW", "MEDIUM", "HIGH"]
              },
              "remaining_uncertainty": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "assessed_risk": {
                "$ref": "#/$defs/risk_level"
              },
              "risk_reasons": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["check", "result"],
                  "properties": {
                    "check": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "result": {
                      "enum": ["passed", "failed", "not_applicable"]
                    },
                    "detail": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              },
              "step_hash": {
                "$ref": "#/$defs/sha256"
              },
              "approved": {
                "type": "boolean"
              }
            }
          }
        },
        "snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "description": "Who did what to which step, in order: authored, challenged, revised, edited, validated, approved. Recorded by KeyJutsu; never taken from an agent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_event"
          }
        }
      }
    },
    "provenance_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "action", "at"],
      "properties": {
        "step": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["agent", "operator", "keyjutsu"]
            },
            "agent": {
              "$ref": "#/$defs/agent"
            }
          }
        },
        "action": {
          "enum": [
            "authored",
            "challenged",
            "revised",
            "edited",
            "validated",
            "approved",
            "dismissed",
            "answered",
            "accepted"
          ]
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}

{
  "schema_version": "1.0",
  "plan_id": "plan-registry-login",
  "task_id": "task-registry-login",
  "title": "Sign in to the container registry",
  "target": {
    "id": "local",
    "kind": "local_windows"
  },
  "agent": {
    "name": "claude_code",
    "version": "2.1.282"
  },
  "steps": [
    {
      "id": "login",
      "title": "Sign in",
      "objective": "Sign in with the token without it appearing on screen.",
      "kind": "command",
      "shell": {
        "kind": "pwsh"
      },
      "commands": [
        {
          "text": "[System.Net.NetworkCredential]::new('', $REGISTRY_TOKEN).Password | docker login ghcr.io --username ci-bot --password-stdin",
          "purpose": "The token goes to docker on standard input, never as an argument."
        }
      ],
      "tool_requirements": [
        {
          "name": "Docker CLI",
          "executable": "docker"
        }
      ],
      "proposed_risk": {
        "level": "normal",
        "rationale": "Stores a registry credential in Docker's credential helper."
      },
      "internal_validation": [
        {
          "exit_code": {
            "equals": 0
          }
        }
      ],
      "credential": {
        "variable": "REGISTRY_TOKEN",
        "prompt": "Token for ghcr.io",
        "kind": "secret",
        "target_id": "local"
      }
    }
  ]
}
